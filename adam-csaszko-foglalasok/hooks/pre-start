#!/usr/bin/env bash
# Umbrel only copies docker-compose.yml, umbrel-app.yml and hooks/ on update. This copies the
# fresh program (bin/, Dockerfile) from the app store before every start, so an update really
# runs the new version. data/ (bookings, settings, statistics) is never touched.
src="${SCRIPT_APP_REPO_DIR:-}"
dst="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -z "${src}" || ! -d "${src}/bin" || "${src}" == "${dst}" ]]; then
  exit 0
fi
if [[ ! -d "${dst}/data" ]]; then
  mkdir -p "${dst}/data" && chown 1000:1000 "${dst}/data"
fi
mkdir -p "${dst}/bin"
cp -f "${src}"/bin/csaszko-foglalasok-linux-* "${dst}/bin/" && chmod +x "${dst}"/bin/csaszko-foglalasok-linux-*
for f in Dockerfile .dockerignore; do
  [[ -f "${src}/${f}" ]] && cp -f "${src}/${f}" "${dst}/${f}"
done
# Leftover of the Node.js version (1.x)
rm -rf "${dst}/server"
echo "Csaszko Foglalások: program files updated from ${src}"
exit 0
