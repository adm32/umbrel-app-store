server {
    listen 8080;

    location / {
        proxy_pass http://${ROUTER_HOST};
        proxy_http_version 1.1;
        proxy_set_header Host ${ROUTER_HOST};
        proxy_set_header Accept-Encoding "";
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Content-Security-Policy;
        # Rewrite redirects that point at the router back to this app
        proxy_redirect http://${ROUTER_HOST}/ /;
        proxy_redirect https://${ROUTER_HOST}/ /;
        proxy_read_timeout 60s;
    }
}
