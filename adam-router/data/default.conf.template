server {
    listen 8080;

    location / {
        proxy_pass ${ROUTER_SCHEME}://${ROUTER_HOST};
        proxy_http_version 1.1;
        proxy_set_header Host ${ROUTER_HOST};
        proxy_set_header Origin ${ROUTER_SCHEME}://${ROUTER_HOST};
        proxy_set_header Referer ${ROUTER_SCHEME}://${ROUTER_HOST}/;
        proxy_set_header Accept-Encoding "";
        proxy_ssl_verify off;
        proxy_ssl_server_name on;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header Strict-Transport-Security;
        # Keep the router's cookies working on this app's address
        proxy_cookie_domain ${ROUTER_HOST} $host;
        proxy_cookie_flags ~ nosecure;
        # Rewrite redirects and absolute links that point at the router back to this app
        proxy_redirect ${ROUTER_SCHEME}://${ROUTER_HOST}/ /;
        sub_filter_once off;
        sub_filter_types text/css application/javascript text/javascript application/json;
        sub_filter "${ROUTER_SCHEME}://${ROUTER_HOST}" "";
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }
}
